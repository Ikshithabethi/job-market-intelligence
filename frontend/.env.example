# ---------------------------------------------------------------------------
# Frontend environment configuration.
# Copy this file to `.env` if you need to override the defaults:
#     cp .env.example .env
#
# By default the app calls the relative path `/api`, which the Vite dev server
# proxies to http://127.0.0.1:5050 (see vite.config.js). Leave this unset during
# normal development. Set it when the backend runs elsewhere, or for a built
# frontend served without the Vite proxy.
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL=http://127.0.0.1:5050/api
