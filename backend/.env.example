# ---------------------------------------------------------------------------
# Backend environment configuration.
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# NEVER commit a real .env file or real passwords.
# ---------------------------------------------------------------------------

# Server
# 5050 is used instead of the very common 5000 to avoid clashes with other
# local tools (on macOS, port 5000 is taken by AirPlay Receiver by default).
PORT=5050
NODE_ENV=development

# Comma separated list of origins allowed to call the API (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# MySQL connection (mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_market_intelligence
DB_CONNECTION_LIMIT=10

# JWT - replace with a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
